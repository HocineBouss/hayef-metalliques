{% extends 'base.html.twig' %}

{% block body %}
<section id="solutions" class="flex-grow-1 d-flex align-items-center bg-light">
  <div class="container text-center py-5">
    <h2 class="fw-bold mb-5">Nos Solutions</h2>

    <div class="row row-cols-1 row-cols-md-3 g-4 justify-content-center">

      {# Carte 1 : Administration #}
      <div class="col">
        <a href="{{ path('app_produit', { slug: 'vcm' }) }}" class="text-decoration-none text-dark h-100 d-flex w-100">
          <div class="card h-100 border-0 shadow-sm d-flex flex-column w-100">

            {# Zone image portrait 2:3 (plus haute que large) #}
            <div class="ratio d-flex align-items-center justify-content-center p-3"
                 style="--bs-aspect-ratio: 150%;">
              <img src="{{ asset('assets/img/v-system/vcm.png') }}" alt="Administration">
            </div>

            <div class="card-body d-flex flex-column">
              <span class="badge bg-danger mb-2 fs-6 align-self-center">V<small>CM</small></span>
              <h3 class="h5 fw-bold mb-3">Administration</h3>
              <p class="mb-0">Gérez et archivez vos documents en toute sécurité.</p>
            </div>
          </div>
        </a>
      </div>

      {# Carte 2 : Entrepôts #}
      <div class="col">
        <a href="{{ path('app_produit', { slug: 'vsm' }) }}" class="text-decoration-none text-dark h-100 d-flex w-100">
          <div class="card h-100 border-0 shadow-sm d-flex flex-column w-100">
            <div class="ratio d-flex align-items-center justify-content-center p-3"
                 style="--bs-aspect-ratio: 150%;">
              <img src="{{ asset('assets/img/v-system/vsm.png') }}" alt="Entrepôts">
            </div>
            <div class="card-body d-flex flex-column">
              <span class="badge bg-danger mb-2 fs-6 align-self-center">V<small>SM</small></span>
              <h3 class="h5 fw-bold mb-3">Entrepôts</h3>
              <p class="mb-0">Gérez, organisez et sécurisez vos stocks simplement et efficacement.</p>
            </div>
          </div>
        </a>
      </div>

      {# Carte 3 : Industriels #}
      <div class="col">
        <a href="{{ path('app_produit', { slug: 'vlm' }) }}" class="text-decoration-none text-dark h-100 d-flex w-100">
          <div class="card h-100 border-0 shadow-sm d-flex flex-column w-100">
            <div class="ratio d-flex align-items-center justify-content-center p-3"
                 style="--bs-aspect-ratio: 150%;">
              <img src="{{ asset('assets/img/v-system/vlm.png') }}" alt="Industriels">
            </div>
            <div class="card-body d-flex flex-column">
              <span class="badge bg-danger mb-2 fs-6 align-self-center">V<small>LM</small></span>
              <h3 class="h5 fw-bold mb-3">Industriels</h3>
              <p class="mb-0">Optimisez vos volumes et maîtrisez vos stocks avec une solution intelligente.</p>
            </div>
          </div>
        </a>
      </div>

    </div>
  </div>
</section>
{% endblock %}
