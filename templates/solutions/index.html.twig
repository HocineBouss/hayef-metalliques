{% extends 'base.html.twig' %}

{% block body %}
<section id="solutions" class="flex-grow-1 d-flex align-items-center bg-light">
  <div class="container-fluid text-center py-5">
    <h2 class="fw-bold mb-5">Nos Solutions</h2>

    <div class="row row-cols-1 row-cols-md-3 g-4 justify-content-center">

      <!-- Carte 1 -->
      <div class="col d-flex">
        <a href="{{ path('app_produit', { slug: 'vcm' }) }}" class="text-decoration-none text-dark w-100">
          <div class="card h-100 border-0 shadow-sm d-flex flex-column">
            <div class="ratio ratio-4x3 bg-white border-bottom">
              <img src="{{ asset('assets/img/v-system/vcm.png') }}"
                   alt="image du VCM / Administration"
                   class="w-100 h-100 p-3 object-fit-contain">
            </div>
            <div class="card-body d-flex flex-column">
              <span class="badge bg-danger mb-2 fs-6 align-self-center">V<small>CM</small></span>
              <h3 class="h5 fw-bold mb-3">Administration</h3>
              <p class="mb-0">Gérez et archivez vos documents en toute sécurité.</p>
            </div>
          </div>
        </a>
      </div>

      <!-- Carte 2 -->
      <div class="col d-flex">
        <a href="{{ path('app_produit', { slug: 'vsm' }) }}" class="text-decoration-none text-dark w-100">
          <div class="card h-100 border-0 shadow-sm d-flex flex-column">
            <div class="ratio ratio-4x3 bg-white border-bottom">
              <img src="{{ asset('assets/img/v-system/vsm.png') }}"
                   alt="image du VSM / Entrepôts"
                   class="w-100 h-100 p-3 object-fit-contain">
            </div>
            <div class="card-body d-flex flex-column">
              <span class="badge bg-danger mb-2 fs-6 align-self-center">V<small>SM</small></span>
              <h3 class="h5 fw-bold mb-3">Entrepôts</h3>
              <p class="mb-0">Gérez, organisez et sécurisez vos stocks simplement et efficacement.</p>
            </div>
          </div>
        </a>
      </div>

      <!-- Carte 3 -->
      <div class="col d-flex">
        <a href="{{ path('app_produit', { slug: 'vlm' }) }}" class="text-decoration-none text-dark w-100">
          <div class="card h-100 border-0 shadow-sm d-flex flex-column">
            <div class="ratio ratio-4x3 bg-white border-bottom">
              <img src="{{ asset('assets/img/v-system/vlm.png') }}"
                   alt="image du VLM / Industriels"
                   class="w-100 h-100 p-3 object-fit-contain">
            </div>
            <div class="card-body d-flex flex-column">
              <span class="badge bg-danger mb-2 fs-6 align-self-center">V<small>LM</small></span>
              <h3 class="h5 fw-bold mb-3">Industriels</h3>
              <p class="mb-0">Optimisez vos volumes et maîtrisez vos stocks avec une solution intelligente.</p>
            </div>
          </div>
        </a>
      </div>

    </div>
  </div>
</section>
{% endblock %}
