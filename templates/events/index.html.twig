{% extends 'base.html.twig' %}

{% block title %}Événements{% endblock %}

{% block body %}
<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Événements</h1>

        {# Filtres en boutons Bootstrap #}
        <div class="btn-group" role="group" aria-label="Filtrer les événements">
            <a href="{{ path('events_index', { status: 'all' }) }}"
               class="btn btn-outline-primary btn-sm {{ status == 'all' ? 'active' : '' }}">
                Tous
            </a>
            <a href="{{ path('events_index', { status: 'ongoing' }) }}"
               class="btn btn-outline-primary btn-sm {{ status == 'ongoing' ? 'active' : '' }}">
                En cours
            </a>
            <a href="{{ path('events_index', { status: 'upcoming' }) }}"
               class="btn btn-outline-primary btn-sm {{ status == 'upcoming' ? 'active' : '' }}">
                À venir
            </a>
            <a href="{{ path('events_index', { status: 'past' }) }}"
               class="btn btn-outline-primary btn-sm {{ status == 'past' ? 'active' : '' }}">
                Passés
            </a>
        </div>
    </div>

    {% if events is not empty %}
        {# Grille responsive Bootstrap #}
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
            {% for event in events %}
                <div class="col">
                    <div class="card h-100">

                        {% if event.image %}
                            <a href="#"
                            data-bs-toggle="modal"
                            data-bs-target="#imagePreviewModal"
                            data-image="{{ asset(event.image) }}"
                            data-title="{{ event.title }}">
                                <img src="{{ asset(event.image) }}"
                                    class="card-img-top"
                                    alt="{{ event.title }}">
                            </a>
                        {% endif %}

                        <div class="card-body d-flex flex-column">
                            <h2 class="h5 card-title">{{ event.title }}</h2>

                            <p class="card-text mb-1">
                                <small class="text-muted">
                                    Du {{ event.startAt|date('d/m/Y H:i') }}
                                    au {{ event.endAt|date('d/m/Y H:i') }}
                                </small>
                            </p>

                            {% if event.location %}
                                <p class="card-text mb-2">
                                    <small>📍 {{ event.location }}</small>
                                </p>
                            {% endif %}

                            {% if event.description %}
                                <p class="card-text">
                                    {{ event.description }}
                                </p>
                            {% endif %}
                        </div>

                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="alert alert-info mt-4" role="alert">
            Aucun événement pour ce filtre.
        </div>
    {% endif %}

</div>
{% endblock %}
