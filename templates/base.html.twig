<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}V-System — {{ company_name|default('HAYEF Métalliques') }}{% endblock %}</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
        crossorigin="anonymous">
  <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
</head>

<body class="d-flex flex-column min-vh-100">

  <!-- HEADER -->
  <header class="bg-danger py-1">
    <nav class="navbar navbar-expand-lg navbar-dark bg-danger">
      <div class="container-fluid">
        <!-- Logo -->
        <a href="{{ path('app_home') }}" class="navbar-brand d-flex align-items-center">
          <img src="{{ asset('assets/img/logo.png') }}" alt="logo" class="img-fluid rounded shadow" style="max-height:50px;">
        </a>

        <!-- Bouton burger -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu" aria-controls="navbarMenu" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Liens -->
        <div class="collapse navbar-collapse justify-content-end" id="navbarMenu">
          <ul class="navbar-nav">
            <li class="nav-item"><a href="{{ path('app_home') }}" class="nav-link text-white">Accueil</a></li>
            <li class="nav-item"><a href="{{ path('app_produits') }}" class="nav-link text-white">Nos produits</a></li>
            <li class="nav-item"><a href="{{ path('events_index') }}" class="nav-link text-white">Événements</a></li>
            <li class="nav-item"><a href="{{ path('app_contact') }}" class="nav-link text-white">Contact</a></li>
            <li class="nav-item"><a href="{{ path('app_apropos') }}" class="nav-link text-white">À propos</a></li>
          </ul>
        </div>
      </div>
    </nav>
  </header>

  <!-- CONTENU PRINCIPAL -->
  <main class="flex-fill">
    {% block body %}{% endblock %}
  </main>

  <!-- FOOTER -->
  <footer class="text-center text-white py-3 bg-danger mt-auto">
    <div class="container small">
      © {{ "now"|date("Y") }} <strong>HAYEF Métalliques</strong>. Tous droits réservés.
    </div>
  </footer>

  {# MODAL ÉVÉNEMENT EN AVANT #}
  {% if highlightedEvent is defined and highlightedEvent %}
    <div class="modal fade" id="eventAlertModal" tabindex="-1" aria-labelledby="eventAlertLabel" aria-hidden="true">
      {# modal-xl = plus grande, max-width géré par Bootstrap #}
      <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h1 class="modal-title fs-5" id="eventAlertLabel">
              Événement à ne pas manquer
            </h1>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
          </div>

          <div class="modal-body">
            {# align-items-center = centre verticalement les 2 colonnes #}
            <div class="row g-4 align-items-center">
              {# GAUCHE : image = moitié de la modal #}
              <div class="col-md-6 d-flex justify-content-center">
                {% if highlightedEvent.image %}
                  <a href="#"
                    data-bs-toggle="modal"
                    data-bs-target="#imagePreviewModal"
                    data-image="{{ asset(highlightedEvent.image) }}"
                    data-title="{{ highlightedEvent.title }}">
                    <img src="{{ asset(highlightedEvent.image) }}"
                        alt="{{ highlightedEvent.title }}"
                        class="img-fluid rounded shadow"
                        style="max-height: 75vh; width: 100%; object-fit: contain;">
                  </a>
                {% endif %}
              </div>

              {# DROITE : texte centré, colonne = moitié droite #}
              <div class="col-md-6 d-flex flex-column justify-content-center text-center">
                <h2 class="h4 mb-3">{{ highlightedEvent.title }}</h2>

                <p class="mb-2">
                  <small class="text-muted">
                    Du {{ highlightedEvent.startAt|date('d/m/Y H:i') }}
                    au {{ highlightedEvent.endAt|date('d/m/Y H:i') }}
                  </small>
                </p>

                {% if highlightedEvent.location %}
                  <p class="mb-2">
                    <small>📍 {{ highlightedEvent.location }}</small>
                  </p>
                {% endif %}

                {% if highlightedEvent.description %}
                  <p class="mb-3">
                    {{ highlightedEvent.description }}
                  </p>
                {% endif %}

                <div>
                  <a href="{{ path('events_index') }}"
                    class="btn btn-primary btn-sm">
                    Voir tous les événements
                  </a>
                </div>
              </div>
            </div>
          </div>

          <div class="modal-footer justify-content-end">
            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
              Fermer
            </button>
          </div>
        </div>
      </div>
    </div>
  {% endif %}


    {# MODAL DE PRÉVISUALISATION D'IMAGE #}
  <div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-labelledby="imagePreviewLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
      <div class="modal-content bg-transparent border-0">
        <div class="modal-header border-0">
          <h1 class="modal-title fs-5 text-white" id="imagePreviewLabel"></h1>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
        </div>
        <div class="modal-body d-flex justify-content-center">
          <img id="imagePreviewImg" src="" alt="" class="img-fluid rounded shadow" style="max-height: 90vh; width: auto;">
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

    {% block javascripts %}
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        // 1. Prévisualisation d'image (lightbox)
        var previewModalEl = document.getElementById('imagePreviewModal');
        if (previewModalEl) {
          previewModalEl.addEventListener('show.bs.modal', function (event) {
            var trigger = event.relatedTarget;
            if (!trigger) return;

            var imgSrc = trigger.getAttribute('data-image');
            var title = trigger.getAttribute('data-title') || '';

            var imgEl = previewModalEl.querySelector('#imagePreviewImg');
            var titleEl = previewModalEl.querySelector('#imagePreviewLabel');

            if (imgEl && imgSrc) {
              imgEl.src = imgSrc;
              imgEl.alt = title;
            }
            if (titleEl) {
              titleEl.textContent = title;
            }
          });
        }

        // 2. Afficher automatiquement la modale d'événement à l'ouverture du site (si présente)
        {% if highlightedEvent is defined and highlightedEvent %}
        var eventModalEl = document.getElementById('eventAlertModal');
        if (eventModalEl) {
          var eventModal = new bootstrap.Modal(eventModalEl);
          eventModal.show();
        }
        {% endif %}
      });
    </script>
  {% endblock %}

</body>
</html>
